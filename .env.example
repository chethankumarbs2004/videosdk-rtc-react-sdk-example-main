# Frontend Video SDK token for the React app
REACT_APP_VIDEOSDK_TOKEN=""

# OR provide your authentication server URL instead of a static token
REACT_APP_AUTH_URL=""

# Backend API URL used by the React app
REACT_APP_API_BASE_URL="http://localhost:5000"

# MongoDB connection for the backend
MONGO_URI="mongodb://localhost:27017/erp"
PORT=5000

# Keep only one of the first two values filled for the React demo.
# For production, prefer an auth server instead of a static token.
